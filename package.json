{
  "name": "drivedesk",
  "private": true,
  "version": "0.1.0",
  "description": "A lightweight Google Drive desktop client with a DBX-style workbench UI",
  "type": "module",
  "license": "MIT",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "build:ui": "vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "test": "vitest run",
    "test:rust": "cargo test --manifest-path src-tauri/Cargo.toml",
    "test:smoke": "node scripts/run-smoke.mjs"
  },
  "dependencies": {
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-dialog": "^2",
    "@tauri-apps/plugin-opener": "^2",
    "pinia": "^3",
    "vue": "^3.5.13",
    "vue-i18n": "^11"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.0",
    "@tauri-apps/cli": "^2",
    "@types/node": "^26.6.5",
    "@vitejs/plugin-vue": "^6",
    "@vue/test-utils": "^2.4.6",
    "happy-dom": "^15",
    "tailwindcss": "^4.1.0",
    "typescript": "~5.9.0",
    "vite": "^7.1.0",
    "vitest": "^3.0.0",
    "vue-tsc": "^3"
  }
}
